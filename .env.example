# Server-only contact-form settings. Set these in Vercel; never prefix them with VITE_ or NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=contact@lacstudio.ro
CONTACT_FROM_EMAIL=LAC STUDIO <contact@lacstudio.ro>

# Required durable, cross-instance rate limiting (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxx
